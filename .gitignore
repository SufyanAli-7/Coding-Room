# Root .gitignore for Coding Room

# Dependencies
node_modules/
package-lock.json.backup

# Production Builds
Client/dist/
Client/dist-ssr/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime & Temporary Files
pids/
*.pid
*.seed
*.pid.lock
.cache/
.temp/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db

# IDE & Editor Configuration
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln
